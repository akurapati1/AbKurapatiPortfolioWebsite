# ---- Server ----
PORT=8787
# Set to the number of reverse proxies in front (e.g. 1 on Render/Fly/Railway) so rate limiting sees real client IPs.
TRUST_PROXY=1
# Origins allowed to call the API from a browser (only needed if the static site is hosted elsewhere, e.g. GitHub Pages).
ALLOWED_ORIGINS=https://akurapati1.github.io,http://localhost:8787

# ---- SMTP (contact form). Gmail example: smtp.gmail.com / 587 / an App Password (not your login password) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=abhilash.kurapati1301@gmail.com
SMTP_PASS=
MAIL_TO=abhilash.kurapati1301@gmail.com
MAIL_FROM=abhilash.kurapati1301@gmail.com
MAIL_FROM_NAME=Abhilash's Portfolio
# Send the visitor an automatic confirmation email (off by default: it can be abused to mail third parties).
SEND_CONFIRMATION=false
# Optional: also append each submission to a local file (a backup if email delivery ever fails).
# MESSAGE_LOG_PATH=./data/messages.jsonl

# ---- Live AI (optional: without a key the site answers from the knowledge base in retrieval mode) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low
# Global ceiling on LLM requests per UTC day. Beyond it the site transparently falls back to retrieval mode.
LLM_DAILY_CALL_BUDGET=400

# ---- Rate limits (per IP) ----
RATE_CHAT=20
RATE_TOOLS=10
RATE_CONTACT=5
